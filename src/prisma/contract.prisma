// use prisma-8

enum UserRole {
  USER
  ADMIN
}

enum ProfitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT
  REFERRAL_COMMISSION
  REFUND
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentGateway {
  EASYPAISA
  BANK
  RAAST
} 
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
model PaymentAccount {
  id String @id @default(uuid())

  gateway PaymentGateway

  accountName String
  accountNumber String

  processingChargePaisa Int @default(0)

  isActive Boolean @default(false)

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  deposits Deposit[]

  @@index([gateway])
  @@index([isActive])
}
model User {
  id String @id @default(uuid())

  fullName String
  username String @unique
  email String @unique
  passwordHash String

  role UserRole @default(USER)

  referralCode String @unique

  referralLevel Int @default(1)

  balancePaisa Int @default(0)

  totalInvestmentPaisa Int @default(0)
  totalProfitPaisa Int @default(0)
  totalReferralPaisa Int @default(0)
  totalWithdrawnPaisa Int @default(0)

  isActive Boolean @default(true)
  isEmailVerified Boolean @default(false)
  emailVerifiedAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  investments Investment[]
  deposits Deposit[] @relation("UserDeposits")
  withdrawals Withdrawal[] @relation("UserWithdrawals")
  transactions Transaction[]

  referralsGiven Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("ReferredUser")

  commissionsEarned ReferralCommission[] @relation("CommissionReceiver")
  commissionsGenerated ReferralCommission[] @relation("CommissionSource")

  reviewedDeposits Deposit[] @relation("DepositReviewer")
  reviewedWithdrawals Withdrawal[] @relation("WithdrawalReviewer")

  notifications Notification[]
  verificationTokens VerificationToken[]
}

model InvestmentPlan {
  id String @id @default(uuid())

  name String

  minAmountPaisa Int
  maxAmountPaisa Int

  // 2000 = 20%
  profitRateBps Int

  // 1400 = 14%
  referralBonusBps Int @default(1400)

  frequency ProfitFrequency
  durationDays Int

  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  investments Investment[]
  deposit Deposit[]
}

model Investment {
  id String @id @default(uuid())

  userId String
  planId String

  amountPaisa Int

  profitRateBps Int
  frequency ProfitFrequency

  startDate TimestamptzString
  endDate TimestamptzString
  nextProfitAt TimestamptzString

  earnedProfitPaisa Int @default(0)

  status InvestmentStatus @default(ACTIVE)

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InvestmentPlan @relation(fields: [planId], references: [id])

  transactions Transaction[]

  referralCommissions ReferralCommission[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([nextProfitAt])
}

model Deposit {
  id String @id @default(uuid())

  userId String
  planId String?

  paymentAccountId String?

  amountPaisa Int

  processingChargePaisa Int @default(0)
  exactAmountPaisa Int

  method String

  transactionReference String
  proofUrl String

  paymentAccountName String
  paymentAccountNumber String

  status DepositStatus @default(PENDING)

  rejectionReason String?

  reviewedBy String?
  reviewedAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  user User @relation(
    "UserDeposits",
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  plan InvestmentPlan? @relation(
    fields: [planId],
    references: [id]
  )

  paymentAccount PaymentAccount? @relation(
    fields: [paymentAccountId],
    references: [id]
  )

  reviewer User? @relation(
    "DepositReviewer",
    fields: [reviewedBy],
    references: [id]
  )

  transactions Transaction[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([paymentAccountId])
}

model Withdrawal {
  id String @id @default(uuid())

  userId String

  amountPaisa Int

  method String

  accountDetails Json

  status WithdrawalStatus @default(PENDING)

  rejectionReason String?

  reviewedBy String?
  reviewedAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  user User @relation(
    "UserWithdrawals",
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  reviewer User? @relation(
    "WithdrawalReviewer",
    fields: [reviewedBy],
    references: [id]
  )

  transactions Transaction[]

  @@index([userId])
  @@index([status])
}

model Transaction {
  id String @id @default(uuid())

  userId String

  type TransactionType

  amountPaisa Int

  balanceBeforePaisa Int
  balanceAfterPaisa Int

  referenceId String?

  description String?

  investmentId String?
  depositId String?
  withdrawalId String?

  createdAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  investment Investment? @relation(
    fields: [investmentId],
    references: [id]
  )

  deposit Deposit? @relation(
    fields: [depositId],
    references: [id]
  )

  withdrawal Withdrawal? @relation(
    fields: [withdrawalId],
    references: [id]
  )

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Referral {
  id String @id @default(uuid())

  referrerId String
  referredUserId String

  level Int

  createdAt TimestamptzString @default(now())

  referrer User @relation(
    "Referrer",
    fields: [referrerId],
    references: [id],
    onDelete: Cascade
  )

  referredUser User @relation(
    "ReferredUser",
    fields: [referredUserId],
    references: [id],
    onDelete: Cascade
  )


  @@unique([referredUserId, level])

  @@index([referrerId])
  @@index([referredUserId])
  @@index([level])
}

model ReferralCommission {
  id String @id @default(uuid())

  receiverId String
  sourceUserId String

  investmentId String?

  level Int

  baseAmountPaisa Int
  commissionRateBps Int
  commissionAmountPaisa Int

  transactionId String?

  createdAt TimestamptzString @default(now())

  receiver User @relation(
    "CommissionReceiver",
    fields: [receiverId],
    references: [id],
    onDelete: Cascade
  )

  sourceUser User @relation(
    "CommissionSource",
    fields: [sourceUserId],
    references: [id],
    onDelete: Cascade
  )

  investment Investment? @relation(
    fields: [investmentId],
    references: [id]
  )

  @@unique([receiverId, sourceUserId, level])

  @@index([receiverId])
  @@index([sourceUserId])
  @@index([investmentId])
  @@index([createdAt])
}
model ReferralSetting {
  id String @id @default("default")

  level1BonusBps Int @default(1300)
  level2BonusBps Int @default(500)

  updatedAt TimestamptzString @default(now())
}

model Notification {
  id String @id @default(uuid())

  userId String

  title String
  message String

  type String @default("INFO")

  isRead Boolean @default(false)

  createdAt TimestamptzString @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model WithdrawalSetting {
  id String @id @default(uuid())

  minWithdrawalPaisa Int @default(50000)

  updatedAt TimestamptzString @default(now())
}

model VerificationToken {
  id String @id @default(uuid())

  userId String

  tokenHash String @unique

  type VerificationTokenType

  expiresAt TimestamptzString

  usedAt TimestamptzString?

  createdAt TimestamptzString @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}